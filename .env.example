# API
MY_API_PORT=8080
MY_WEB_PORT=5173
MY_API_URL=http://localhost:8080
MY_WEB_URL=http://localhost:5173

# Database (libSQL embedded by default)
MY_DATABASE_URL=file:my_dev.db
MY_TEST_DATABASE_URL=file:my_test.db

# Turso (optional — set to use remote instead of embedded)
# MY_TURSO_URL=libsql://your-db.turso.io
# MY_TURSO_AUTH_TOKEN=your-token

# Redis
MY_REDIS_URL=redis://localhost:6379

# Auth — single-user magic link
MY_USER_EMAIL=you@example.com
MY_SESSION_TTL=168h
# Unset derives from MY_WEB_URL scheme (https -> secure cookies).
# MY_SECURE_COOKIES=false

# SMTP (Mailpit in dev: localhost:1025, Mailpit UI localhost:8025)
MY_SMTP_HOST=localhost
MY_SMTP_PORT=1025
MY_SMTP_FROM=my@localhost
MY_SMTP_USER=
MY_SMTP_PASS=

# Currency
MY_DEFAULT_CURRENCY=PHP

# MCP server for coding agents. Disabled by default.
MY_MCP_ENABLED=false
# Required when MY_MCP_ENABLED=true. Generate: openssl rand -hex 32
MY_MCP_TOKEN=
# Widening this beyond localhost exposes full finance CRUD.
MY_MCP_BIND=127.0.0.1
# Register read-only MCP tools only.
MY_MCP_READONLY=false

# Brave Search API (for MCP server — get a free key at https://brave.com/search/api/)
BRAVE_API_KEY=

# Context7 API (optional — increases remote MCP rate limits)
CONTEXT7_API_KEY=

# Playwright MCP extension token (optional/local only — never commit real value)
PLAYWRIGHT_MCP_EXTENSION_TOKEN=
