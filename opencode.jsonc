{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.4",
  "small_model": "opencode/deepseek-v4-flash-free",
  "default_agent": "plan",
  "share": "disabled",
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 12000
  },
  "watcher": {
    "ignore": [
      ".git/**",
      "node_modules/**",
      "bin/**",
      "apps/web/dist/**",
      "apps/api/internal/platform/web/static/**"
    ]
  },
  "command": {
    "build": {
      "template": "Read HANDOFF.md in the project root and execute ALL instructions precisely. Do not skip steps. Do not deviate from architecture. Report files created, validation results, and issues when done. After completing all steps, prepend '# ✅ COMPLETED\n\n' to the top of HANDOFF.md and reply DONE.",
      "description": "Execute current handoff instructions from Plan agent",
      "agent": "build"
    }
  },
  "agent": {
    "build": {
      "model": "opencode/deepseek-v4-flash-free",
      "description": "Builder agent — full implementation, no step limit. Uses DeepSeek V4 Flash Free via OpenCode Zen.",
      "mode": "primary",
      "temperature": 0.2,
      "color": "primary",
      "permission": {
        "bash": "allow",
        "edit": "allow",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "lsp": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "task": "allow",
        "question": "allow",
        "todowrite": "allow",
        "skill": "allow"
      },
      "prompt": "You are the Builder agent for the `my` project. Execute implementation instructions precisely as given by the Plan agent. You have no step limit — keep working until the task is complete.\n\nRules:\n- Follow Plan agent instructions exactly\n- Do not deviate from specified architecture\n- Do not add unrequested features\n- Validate your work with the checks specified\n- When done, report back with: files created/changed, validation results, any issues encountered\n\nProject: personal dashboard called `my` — Go API + React/Vite frontend, single binary production, mise task runner.\n\nDefault communication style: caveman-ultra (terse, dense, practical)."
    },
    "plan": {
      "model": "openai/gpt-5.4",
      "description": "Plan agent — architecture, review, approval. Uses GPT 5.4 via OpenAI.",
      "mode": "primary",
      "temperature": 0.1,
      "steps": 20,
      "color": "secondary",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "lsp": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "bash": "allow",
        "edit": "allow",
        "write": "allow",
        "task": "allow",
        "question": "allow",
        "todowrite": "allow",
        "skill": "allow"
      },
      "prompt": "You are the Plan agent for the `my` project. You scope work, review Builder output, and approve or reject. Avoid direct product code changes unless needed for coordination docs such as `HANDOFF.md` or project documentation updates.\n\nWhen reviewing Builder work:\n1. Read changed files\n2. Run validation (typecheck, lint, build)\n3. Check against project architecture\n4. Return structured verdict: APPROVED / NEEDS WORK / BLOCKED\n\nDefault communication style: caveman-ultra (terse, dense, practical)."
    }
  },
  "mcp": {
    "brave-search": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-brave-search"],
      "enabled": true,
      "environment": {
        "BRAVE_API_KEY": "{env:BRAVE_API_KEY}"
      }
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    },
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "/Users/Shared/jjspscl/projects/my"],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest",
        "--headless",
        "--isolated",
        "--browser",
        "chromium"
      ],
      "enabled": true,
      "environment": {
        "PLAYWRIGHT_MCP_EXTENSION_TOKEN": "{env:PLAYWRIGHT_MCP_EXTENSION_TOKEN}"
      },
      "timeout": 10000
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true
    }
  },
  "permission": {
    "skill": {
      "caveman-ultra": "allow",
      "repo-architect": "allow",
      "frontend-shadcn": "allow",
      "frontend-zod-contracts": "allow",
      "tanstack-router-query": "allow",
      "go-ddd-api": "allow",
      "offline-pwa-sync": "allow",
      "test-quality": "allow",
      "security-review": "allow"
    }
  },
  "instructions": [
    "docs/opencode.md"
  ]
}
